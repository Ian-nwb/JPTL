# ==============================================================================
# JPTL Backend API Server - Environment Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & PROCESS CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
ENABLE_CLUSTER=false

# ------------------------------------------------------------------------------
# 2. CORS & TRUSTED CLIENT ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of frontend domains:
# Local dev:   http://localhost:5173,http://localhost:5174
# Vercel prod: https://client.yourdomain.com,https://superadmin.yourdomain.com
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (MONGODB)
# ------------------------------------------------------------------------------
# Local:       mongodb://localhost:27017/jptl
# Atlas:       mongodb+srv://<user>:<password>@cluster.mongodb.net/jptl?retryWrites=true&w=majority
# AWS DocDB:   mongodb://<user>:<pass>@<cluster>.docdb.amazonaws.com:27017/jptl?tls=true&replicaSet=rs0
# Azure Cosmos:mongodb://<account>:<key>@<account>.mongo.cosmos.azure.com:10255/jptl?ssl=true
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jptl?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_64_chars_recommended
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. FILE & MEDIA STORAGE (CLOUDINARY)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & PASSWORD RESET (SMTP)
# ------------------------------------------------------------------------------
# Gmail:       smtp.gmail.com / 465 / true
# AWS SES:     email-smtp.<region>.amazonaws.com / 465 / true
# SendGrid:    smtp.sendgrid.net / 587 / false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="JPTL Property Management <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com
