# JPTL Superadmin Root Console Environment Configuration Template

# API Base URL (defaults to /api which leverages Vite dev proxy or reverse proxy)
# For remote backend: https://api.yourdomain.com/api
VITE_API_URL=/api

# Application Metadata
VITE_APP_NAME="JPTL Superadmin Console"
VITE_APP_ENV=development
VITE_PROXY_TARGET=http://localhost:8000
