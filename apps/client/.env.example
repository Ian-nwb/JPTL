# ==============================================================================
# JPTL Resident & Landlord Client Portal - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BASE URL
# ------------------------------------------------------------------------------
# [LOCAL / DOCKER DEV]: Leave as '/api' to use Vite's internal reverse proxy.
# [VERCEL DEPLOYMENT]: Set to your deployed backend API URL + '/api':
#   - AWS App Runner / ALB:  https://api.yourdomain.com/api
#   - Azure App Service:     https://jptl-server.azurewebsites.net/api
#   - Render / Railway:      https://jptl-server.onrender.com/api
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 2. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Must match the VAPID_PUBLIC_KEY defined on your backend server.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ------------------------------------------------------------------------------
# 3. APPLICATION METADATA & ENVIRONMENT
# ------------------------------------------------------------------------------
# [LOCAL DEV]: 'development'
# [AWS / VERCEL / AZURE PRODUCTION]: Change to 'production'
VITE_APP_NAME="JPTL Property Management"
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 4. LOCAL / DOCKER REVERSE PROXY TARGET
# ------------------------------------------------------------------------------
# Only used by Vite's dev server to proxy /api -> backend.
# [LOCAL (Host machine)]: http://localhost:8000
# [DOCKER COMPOSE]:      http://server:8000
# [VERCEL / AWS / AZURE]: Not used in production bundle builds
VITE_PROXY_TARGET=http://localhost:8000
