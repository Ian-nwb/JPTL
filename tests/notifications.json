{
  "info": {
    "name": "Notifications & VAPID Push Module",
    "description": "Postman test collection for Web Push Notifications & VAPID subscription endpoints.\nIncludes public VAPID key retrieval, authenticated subscription registration, and unauthorized access guards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "tenant_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Public - Get VAPID Public Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('VAPID public key returned', () => {",
              "  pm.expect(res.success).to.be.true;",
              "  pm.expect(res.publicKey || res.vapidPublicKey).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/notifications/vapid-key",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications", "vapid-key"]
        }
      }
    },
    {
      "name": "02. Auth - Login Tenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('tenant_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sophia@jptl.dev\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "03. Error Handling - Subscribe Without Auth (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"https://fcm.googleapis.com/fcm/send/sample-token\",\n    \"keys\": {\n      \"p256dh\": \"BNcRdreALRF8FsII\",\n      \"auth\": \"tBHItJAhVo\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/notifications/subscribe",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications", "subscribe"]
        }
      }
    },
    {
      "name": "04. Tenant - Register Push Subscription (201/200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "pm.test('Subscription registered', () => pm.expect(res.success).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"https://fcm.googleapis.com/fcm/send/sample-token-12345\",\n    \"keys\": {\n      \"p256dh\": \"BNcRdreALRF8FsII-sample-key\",\n      \"auth\": \"tBHItJAhVo-sample-auth\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/notifications/subscribe",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications", "subscribe"]
        }
      }
    }
  ]
}
