{
  "info": {
    "name": "Resident Compliance Vault & Documents Module (Landlord & Tenant)",
    "description": "Postman test collection for Resident Compliance Vault & Document Upload endpoints across Tenant and Landlord roles.\nIncludes document submission (insurance, ID, income, etc.), Cloudinary URL attachment, compliance queue inspection, verification/rejection workflows, streaming proxy delivery, and error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "landlord_token", "value": "", "type": "string" },
    { "key": "tenant_token", "value": "", "type": "string" },
    { "key": "created_document_id", "value": "", "type": "string" },
    { "key": "temp_delete_doc_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth – Login as Tenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('tenant_token', token);",
              "  console.log('Tenant token saved.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sophia@jptl.dev\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "02. Auth – Login as Landlord",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('landlord_token', token);",
              "  console.log('Landlord token saved.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"landlord@jptl.dev\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "03. Tenant – Submit Verification Document (Insurance/ID)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Status initialized to Pending Review', () => pm.expect(res.data.status).to.equal('Pending Review'));",
              "if (res.data) {",
              "  pm.collectionVariables.set('created_document_id', res.data._id || res.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Final Project Specification_MWA.pdf\",\n  \"type\": \"Proof of Insurance\",\n  \"category\": \"upload\",\n  \"fileSize\": \"0.3 MB\",\n  \"fileUrl\": \"https://res.cloudinary.com/fzpweior/image/upload/v1789310514/jptl_compliance_vault/1789310511958_Final_Project_Specification_MWA.pdf\",\n  \"notes\": \"Policy effective 2026-2027 underwritten by Travelers.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/tenant/documents",
          "host": ["{{base_url}}"],
          "path": ["api", "tenant", "documents"]
        }
      }
    },
    {
      "name": "04. Tenant – List My Submitted Documents",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Returns documents array & metrics', () => {",
              "  pm.expect(Array.isArray(res.documents)).to.be.true;",
              "  pm.expect(res.metrics).to.have.property('pending');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/tenant/documents",
          "host": ["{{base_url}}"],
          "path": ["api", "tenant", "documents"]
        }
      }
    },
    {
      "name": "05. Landlord – Compliance Vault Inspection Queue",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Contains compliance metrics', () => {",
              "  pm.expect(res.metrics).to.have.property('complianceRate');",
              "  pm.expect(res.metrics).to.have.property('pendingReview');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/documents",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "documents"]
        }
      }
    },
    {
      "name": "06. Landlord – Verify Compliance Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Document verified', () => pm.expect(res.document.status).to.equal('Verified'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Verified\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/landlord/documents/{{created_document_id}}/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "documents", "{{created_document_id}}", "verify"]
        }
      }
    },
    {
      "name": "07. Error Handling – Invalid Verification Status (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Invalid_Status_Choice\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/landlord/documents/{{created_document_id}}/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "documents", "{{created_document_id}}", "verify"]
        }
      }
    },
    {
      "name": "08. Landlord – Stream / Proxy Document File",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is application/pdf', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/documents/{{created_document_id}}/file",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "documents", "{{created_document_id}}", "file"]
        }
      }
    },
    {
      "name": "09. Tenant – Stream / Proxy Document File",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is application/pdf', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/tenant/documents/{{created_document_id}}/file",
          "host": ["{{base_url}}"],
          "path": ["api", "tenant", "documents", "{{created_document_id}}", "file"]
        }
      }
    },
    {
      "name": "10. Error Handling – Stream Non-existent Document File (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/documents/000000000000000000000000/file",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "documents", "000000000000000000000000", "file"]
        }
      }
    },
    {
      "name": "11. Error Handling – Stream Document File Unauthenticated (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/landlord/documents/{{created_document_id}}/file",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "documents", "{{created_document_id}}", "file"]
        }
      }
    },
    {
      "name": "12. Error Handling – Cannot Delete Verified Document (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/tenant/documents/{{created_document_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "tenant", "documents", "{{created_document_id}}"]
        }
      }
    },
    {
      "name": "13. Tenant – Create Temporary Pending Document For Deletion",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "if (res.data) {",
              "  pm.collectionVariables.set('temp_delete_doc_id', res.data._id || res.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Temporary_Pet_Agreement_To_Delete.pdf\",\n  \"type\": \"Pet Registration\",\n  \"category\": \"upload\",\n  \"fileSize\": \"0.5 MB\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/tenant/documents",
          "host": ["{{base_url}}"],
          "path": ["api", "tenant", "documents"]
        }
      }
    },
    {
      "name": "14. Tenant – Delete Own Pending Document (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Document deleted successfully', () => pm.expect(res.success).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/tenant/documents/{{temp_delete_doc_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "tenant", "documents", "{{temp_delete_doc_id}}"]
        }
      }
    }
  ]
}
